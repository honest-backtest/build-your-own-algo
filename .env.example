# Copy to .env (which git ignores) and fill in your own values.
# Every name below is a placeholder used by the companion code.

# Broker credentials: read ONLY by your own adapter (adapters/template_adapter.py)
BROKER_API_KEY=
BROKER_CLIENT_ID=
BROKER_TOTP_SEED=

# Your broker's instrument-master download address (see your broker's documentation)
INSTRUMENT_MASTER_URL=

# Optional alerts: a webhook address for your messaging service (leave empty to log only)
ALERT_WEBHOOK_URL=

# Where the code keeps its files (relative defaults shown)
ALGO_DATA_DIR=./data
ALGO_CACHE_DIR=./cache
ALGO_STATE_DIR=./state
ALGO_CONTROL_DIR=./control
